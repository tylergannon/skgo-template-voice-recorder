+// dvEncodeTime and dvDecodeTime use time.Time's own JSON methods, so the wire
+// string is exactly the one encoding/json would produce and accept.
+func dvEncodeTime(v time.Time, at string) (any, error) {
+	encoded, err := v.MarshalJSON()
+	if err != nil {
+		return nil, dvErr(at, "%v", err)
+	}
+	var s string
+	if err := json.Unmarshal(encoded, &s); err != nil {
+		return nil, dvErr(at, "%v", err)
+	}
+	return s, nil
+}
+
+func dvDecodeTime(raw any, at string) (time.Time, error) {
+	s, err := dvString(raw, at)
+	if err != nil {
+		return time.Time{}, err
+	}
+	quoted, err := json.Marshal(s)
+	if err != nil {
+		return time.Time{}, dvErr(at, "%v", err)
+	}
+	var v time.Time
+	if err := v.UnmarshalJSON(quoted); err != nil {
+		return time.Time{}, dvErr(at, "%v", err)
+	}
+	return v, nil
+}
