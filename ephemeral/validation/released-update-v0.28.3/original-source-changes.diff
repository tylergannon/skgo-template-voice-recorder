+// dvFloat32 narrows a wire number, refusing values outside float32's range so
+// a decode never silently yields an infinity.
+func dvFloat32(raw any, at string) (float32, error) {
+	v, err := dvNumber(raw, at)
+	if err != nil {
+		return 0, err
+	}
+	if !math.IsInf(v, 0) && !math.IsNaN(v) && math.Abs(v) > math.MaxFloat32 {
+		return 0, dvErr(at, "number %v is out of range for float32", v)
+	}
+	return float32(v), nil
