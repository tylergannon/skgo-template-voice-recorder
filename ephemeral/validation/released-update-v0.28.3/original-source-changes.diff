+// dvInteger admits only integral numbers inside [min, max]. The bounds are
+// float64 because every wire number is one; kinds wider than 2^53 are checked
+// against the rounded bound, which is the same precision the encoder has.
+func dvInteger(raw any, at string, min, max float64) (float64, error) {
+	v, err := dvNumber(raw, at)
+	if err != nil {
+		return 0, err
+	}
+	if math.IsInf(v, 0) || math.IsNaN(v) || v != math.Trunc(v) {
+		return 0, dvErr(at, "expected an integer, got %v", v)
+	}
+	if v < min || v > max {
+		return 0, dvErr(at, "number %v is out of range", v)
+	}
+	return v, nil
