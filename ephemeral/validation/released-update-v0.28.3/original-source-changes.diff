+// dvTagged rebuilds a union payload with the discriminator first, leaving any
+// discriminator the payload itself carried out of the result.
+func dvTagged(payload any, discriminator string, tag string, at string) (any, error) {
+	o, err := dvObject(payload, at)
+	if err != nil {
+		return nil, err
+	}
+	out := devalue.NewObject()
+	out.Set(discriminator, tag)
+	for _, k := range o.Keys() {
+		if k == discriminator {
+			continue
+		}
+		v, _ := o.Get(k)
+		out.Set(k, v)
+	}
+	return out, nil
+}
