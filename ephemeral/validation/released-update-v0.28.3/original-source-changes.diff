+// dvAt renders a JSON-pointer-style path for a diagnostic. The root value has
+// the empty path, which is spelled "/" so a message never starts with ": ".
+func dvAt(at string) string {
+	if at == "" {
+		return "/"
+	}
+	return at
+}
+
+func dvErr(at string, format string, args ...any) error {
+	return fmt.Errorf("%s: %s", dvAt(at), fmt.Sprintf(format, args...))
+}
+
+// dvKind names the devalue value model kind of v for wrong-kind diagnostics.
+// Every tagged form is named so a rejected Date or Map says which one it was.
+func dvKind(v any) string {
+	switch v.(type) {
+	case nil:
+		return "null"
+	case devalue.UndefinedValue:
+		return "undefined"
+	case devalue.HoleValue:
+		return "a sparse-array hole"
+	case bool:
+		return "a boolean"
+	case float64:
+		return "a number"
+	case string:
+		return "a string"
+	case []any:
+		return "an array"
+	case *devalue.Object:
+		return "an object"
+	case devalue.Date:
+		return "a Date"
+	case *devalue.Map:
+		return "a Map"
+	case *devalue.Set:
+		return "a Set"
+	case devalue.BigInt:
+		return "a BigInt"
+	case devalue.RegExp:
+		return "a RegExp"
+	case devalue.ArrayBuffer:
+		return "an ArrayBuffer"
+	case *devalue.Boxed:
+		return "a boxed primitive"
+	default:
+		return fmt.Sprintf("a value of type %T", v)
+	}
+}
