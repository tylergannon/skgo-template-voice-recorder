+// dvWithout copies o omitting key, so a union payload decoder does not see the
+// discriminator it never declared as a field.
+func dvWithout(o *devalue.Object, key string) *devalue.Object {
+	out := devalue.NewObject()
+	for _, k := range o.Keys() {
+		if k == key {
+			continue
+		}
+		v, _ := o.Get(k)
+		out.Set(k, v)
+	}
+	return out
+}
