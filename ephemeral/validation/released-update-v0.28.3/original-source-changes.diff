+// dvRequired reads a property that must be present and must not be undefined.
+// at is the property's own path, so the diagnostic points at the value.
+func dvRequired(o *devalue.Object, key string, at string) (any, error) {
+	v, ok := o.Get(key)
+	if !ok {
+		return nil, dvErr(at, "missing required property %q", key)
+	}
+	if _, undefined := v.(devalue.UndefinedValue); undefined {
+		return nil, dvErr(at, "value is undefined")
+	}
+	return v, nil
+}
